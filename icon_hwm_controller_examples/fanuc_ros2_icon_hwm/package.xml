<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fanuc_ros2_icon_hwm</name>
  <version>0.0.1</version>
  <description>Configuration files for an ICON hardware module based on the FANUC ROS 2 driver.</description>
  <maintainer email="tobit@intrinsic.ai">Tobit Flatscher</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fanuc_crx_description</exec_depend>
  <exec_depend>fanuc_hardware_interface</exec_depend>
  <exec_depend>icon_hwm_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>