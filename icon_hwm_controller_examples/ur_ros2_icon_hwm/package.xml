<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_ros2_icon_hwm</name>
  <version>0.0.1</version>
  <description>Configuration files for an ICON hardware module based on the Universal Robots ROS 2 driver.</description>
  <maintainer email="nilsb@intrinsic.ai">Nils Berg</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>icon_hwm_controller</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>