<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>icon_shared_memory_vendor</name>
  <version>0.1.0</version>
  <description>
    ROS 2 wrapper for Intrinsic ICON's shared memory communication libraries.
  </description>
  <author email="nilsb@intrinsic.ai">Nils Berg</author>
  <maintainer email="nilsb@intrinsic.ai">Nils Berg</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <depend>eigen_vendor</depend>
  <depend>flatbuffers_vendor</depend>
  <!-- Due to a current short-coming in the translation between Bazel and CMake,
       currently Google Mock is always needed and is not just a test_depend. -->
  <depend>libgmock-dev</depend>
  <depend>tl_expected</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
